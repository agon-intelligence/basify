{{!< default}}

{{#page}}
<article class="article {{page_class}}">

    <header class="article-header">
        {{#if @page.show_title_and_feature_image}}
            {{#if feature_image}}
                <img class="article-image" src="{{feature_image}}" alt="{{title}}" />
            {{/if}}
            <h1 class="article-title">{{title}}</h1>
        {{/if}}
    </header>

    <section class="article-content">
        {{content}}
    </section>

</article>
{{/page}}
