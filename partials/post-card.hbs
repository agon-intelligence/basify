{{!-- Post card partial with ASCII styling --}}
<article class="post-card">
    <header class="post-card-header">
        <h2 class="post-card-title">
            {{#if feature_image}}
                <a href="{{url}}">{{title}}</a>
            {{else}}
                <a href="{{url}}">{{title}}</a>
            {{/if}}
        </h2>
        <div class="post-card-meta">
            <time class="post-card-meta-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
            {{#primary_author}}
                <span class="post-card-meta-author">by {{name}}</span>
            {{/primary_author}}
        </div>
    </header>

    {{#if feature_image}}
        <div class="post-card-image">
            <a href="{{url}}">
                <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy" />
            </a>
        </div>
    {{/if}}

    <div class="post-card-content">
        <div class="post-card-excerpt">
            {{#if custom_excerpt}}
                <p>{{custom_excerpt}}</p>
            {{else}}
                <p>{{excerpt words="30"}}</p>
            {{/if}}
        </div>
        <div class="post-card-footer">
            <a href="{{url}}" class="post-card-read-more">[READ MORE]</a>
            {{#if tags}}
                <div class="post-card-tags">
                    TAGS: {{#foreach tags}}{{name}}{{#unless @last}}, {{/unless}}{{/foreach}}
                </div>
            {{/if}}
        </div>
    </div>
</article>